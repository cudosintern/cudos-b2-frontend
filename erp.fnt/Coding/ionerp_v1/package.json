  "scripts": {
    "start": "env-cmd -f .env.development react-app-rewired start",
    "build": "env-cmd -f .env.production react-app-rewired build",
    "build:deploy": "node build-deploy.js",
    "build:params": "node build-deploy-params.js",
    "build:deploy:ps": "powershell -ExecutionPolicy Bypass -File build-deploy.ps1",
    "build:erp": "node build-deploy.js erp",
    "build:erp:fast": "node build-deploy.js erp .env.fast",
    "preview": "npx serve -s build -l 3000 --single",
    "preview:erp": "node preview-server.js",
    "preview:local": "cd build && npx http-server . -p 3000 -c-1",
    "build:analyze": "npm run build && npx webpack-bundle-analyzer build/static/js/*.js",
    "build:fast": "env-cmd -f .env.fast react-app-rewired build",
    "build:fast:analyze": "node build-analyzer.js \"npm run build:fast\"",
    "build:analyze:time": "node build-analyzer.js \"npm run build\"",
    "build:report": "node build-report.js \"npm run build:fast\"",
    "build:report:prod": "node build-report.js \"npm run build\"",
    "build:monitor": "powershell -ExecutionPolicy Bypass -File build-analyzer.ps1 \"npm run build:fast\"",
    "build:monitor:prod": "powershell -ExecutionPolicy Bypass -File build-analyzer.ps1 \"npm run build\"",
    "build:vanilla": "env-cmd -f .env.fast react-scripts build",
    "start:vanilla": "env-cmd -f .env.development react-scripts start",
    "build:server": "env-cmd -f .env.server react-app-rewired build",
    "build:server:fast": "env-cmd -f .env.server react-app-rewired build",
    "build:server:vanilla": "env-cmd -f .env.server react-scripts build",
    "build:server:safe": "npm install --production=false && env-cmd -f .env.server react-app-rewired build",
    "build:linux": "./build-linux.sh",
    "deploy:server": "./deploy-server.sh",
    "diagnose:linux": "./diagnose-linux.sh",
    "test": "react-app-rewired test",
    "test:deployment": "node test-deployment.js",
    "status:deployment": "node deployment-status.js",
    "eject": "react-scripts eject",
    "clean": "rimraf build node_modules/.cache .tsbuildinfo",
    "preinstall": "npx check-node-version --node >=16"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
