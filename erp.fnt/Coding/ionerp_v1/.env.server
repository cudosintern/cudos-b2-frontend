REACT_APP_API_URL=http://10.91.3.217:7001

# ULTRA-FAST BUILD SETTINGS FOR ROCKY LINUX SERVER
# Same optimizations as Windows development for 1.6-minute builds

# Disable ALL heavy operations
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false
IMAGE_INLINE_SIZE_LIMIT=0
DISABLE_ESLINT_PLUGIN=true
TSC_COMPILE_ON_ERROR=true
FAST_REFRESH=false
SKIP_PREFLIGHT_CHECK=true

# Memory optimization for Linux (compatible with all Node.js versions)
NODE_OPTIONS="--max-old-space-size=8192 --no-warnings"

# Webpack ultra-fast optimizations
WEBPACK_OPTIMIZE_CSS_ASSETS=false
WEBPACK_MINIMIZE=false
WEBPACK_DISABLE_TERSER=true

# Build optimizations
BUILD_PATH=build
DISABLE_NEW_JSX_TRANSFORM=false

# Disable ALL checks for maximum speed
REACT_APP_DISABLE_FAST_REFRESH=true
REACT_APP_DISABLE_TYPE_CHECK=true
DISABLE_TYPE_CHECKER=true
TYPESCRIPT_TYPE_CHECKING=false

# Linux server optimizations (match Windows performance)
CI=true
NODE_ENV=production
EXTEND_ESLINT=false
ESLINT_NO_DEV_ERRORS=true

# Force filesystem caching (same as Windows)
WEBPACK_CACHE=filesystem
WEBPACK_CACHE_TYPE=filesystem

# Parallel processing optimization
FORCE_COLOR=0
PARALLEL=true
